{
  "name": "synax",
  "productName": "Synax",
  "private": false,
  "version": "2.9.0",
  "license": "Apache-2.0",
  "author": "Synax",
  "description": "Synax AI coding workspace",
  "type": "module",
  "main": "dist-electron/main.js",
  "files": [
    "server-dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "bin": {
    "synax": "server-dist/cli.cjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "tsx scripts/dev-profile.ts web-dev all",
    "dev:local": "tsx scripts/dev-profile.ts web-dev local",
    "dev:client": "tsx scripts/dev-profile.ts web-dev client",
    "dev:all": "tsx scripts/dev-profile.ts web-dev all",
    "prebuild": "node scripts/prepare-pty.cjs",
    "postinstall": "node scripts/prepare-pty.cjs",
    "build": "tsup --config tsup.config.ts && tsup --config tsup.cua-helper.config.ts",
    "postbuild": "tsx scripts/copy-native-modules.ts",
    "prepack": "npm run build",
    "start": "node ./server-dist/server.cjs",
    "cli": "tsx cli/index.ts",
    "cli:build": "npm run build",
    "start:local": "tsx scripts/start-local.ts",
    "client:dev": "npm run dev:client",
    "client:build": "npm run --prefix client build",
    "typecheck": "tsc --noEmit && tsc -p cua-helper/tsconfig.json --noEmit",
    "typecheck:cli": "tsc -p cli/tsconfig.json --noEmit",
    "lint": "eslint services/ packages/ scripts/",
    "test": "vitest run",
    "dev:desktop": "tsx scripts/dev-profile.ts desktop-dev desktop",
    "build:electron": "tsc -p electron/tsconfig.json && tsx scripts/build-desktop-updater-runtime.ts",
    "build:desktop": "npm run build && npm run client:build && npm run build:electron && electron-forge package",
    "prepare:windows-signing": "tsx scripts/prepare-windows-signing.ts",
    "make:desktop": "npm run prepare:windows-signing && npm run build && npm run client:build && npm run build:electron && electron-forge make && tsx scripts/build-nsis-installer.ts",
    "start:desktop": "electron-forge start",
    "test:desktop": "vitest run electron/desktop.test.ts scripts/desktop-branding.test.ts scripts/prepare-dmg-native.test.ts scripts/dmg-install-help.test.ts",
    "test:desktop:smoke": "tsx scripts/desktop-smoke.ts",
    "test:desktop:appearance": "tsx scripts/desktop-appearance-e2e.ts",
    "test:ui-updates": "vitest run electron/lib/ui-update-format.test.ts electron/lib/ui-update-store.test.ts electron/lib/ui-update-feed.test.ts electron/lib/ui-updates.test.ts scripts/ui-release-artifacts.test.ts",
    "test:desktop-updates": "vitest run electron/lib/desktop-update-feed.test.ts electron/lib/desktop-update-cache.test.ts electron/lib/desktop-differential.test.ts electron/lib/desktop-update-signing.test.ts electron/lib/desktop-updates.test.ts electron/lib/update-network.test.ts electron/lib/update-settings-store.test.ts electron/lib/mac-desktop-update.test.ts electron/lib/mac-compat-updater.test.ts electron/lib/mac-update-archive.test.ts electron/updater/controller.test.ts electron/updater/framework-feed.test.ts electron/updater/update-errors.test.ts scripts/build-nsis-installer.test.ts scripts/prepare-windows-signing.test.ts scripts/build-desktop-updater-runtime.test.ts scripts/desktop-release-artifacts.test.ts scripts/publish-desktop-release.test.ts scripts/publish-desktop-preview.test.ts",
    "test:desktop:update-smoke": "tsx scripts/desktop-update-smoke.ts",
    "test:desktop:ui-update-smoke": "tsx scripts/ui-update-smoke.ts",
    "test:wsl:smoke": "tsx scripts/wsl-smoke.ts",
    "test:visualize:client": "tsx scripts/visualization-web-e2e.ts",
    "test:visualize:desktop": "tsx scripts/visualization-native-smoke.ts",
    "prebuild:electron": "node -e \"require('node:fs').rmSync('dist-electron', {recursive:true, force:true})\"",
    "test:realtime:web": "tsx scripts/realtime-web-smoke.ts",
    "version:sync": "node scripts/release-version.mjs sync",
    "version:patch": "node scripts/release-version.mjs patch",
    "version:minor": "node scripts/release-version.mjs minor",
    "test:code-mode": "vitest run services/local-node/modules/agent-runtime/code-mode",
    "test:code-mode:bundle": "node scripts/code-mode-smoke.mjs",
    "runtime-sidecar:check": "node scripts/runtime-sidecar-cargo.mjs check",
    "runtime-sidecar:test": "node scripts/runtime-sidecar-cargo.mjs test",
    "runtime-sidecar:build": "node scripts/runtime-sidecar-cargo.mjs build --release",
    "runtime-sidecar:smoke": "npm run runtime-sidecar:build && node scripts/runtime-sidecar-smoke.mjs",
    "runtime-sidecar:crash-smoke": "npm run runtime-sidecar:build && node scripts/runtime-sidecar-crash-smoke.mjs",
    "runtime-sidecar:node-authoritative-smoke": "npm run runtime-sidecar:build && node --import tsx/esm scripts/runtime-sidecar-node-authoritative-smoke.ts",
    "runtime-sidecar:worker-authoritative-smoke": "npm run runtime-sidecar:build && node --import tsx/esm scripts/runtime-sidecar-worker-authoritative-smoke.ts",
    "runtime-sidecar:supervisor-smoke": "npm run runtime-sidecar:build && node --import tsx/esm scripts/runtime-sidecar-supervisor-smoke.ts",
    "runtime-sidecar:electron-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-electron-smoke.ts",
    "runtime-sidecar:lifecycle-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-lifecycle-smoke.ts",
    "runtime-sidecar:ui-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-ui-smoke.ts",
    "runtime-sidecar:recovery-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-recovery-smoke.ts",
    "runtime-sidecar:queue-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-queue-smoke.ts",
    "runtime-sidecar:control-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-control-smoke.ts",
    "runtime-sidecar:history-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-history-smoke.ts",
    "runtime-sidecar:benchmark": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-benchmark.ts",
    "runtime-sidecar:history-benchmark": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-history-benchmark.ts",
    "runtime-sidecar:worker-process-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-worker-process-smoke.ts",
    "runtime-sidecar:storage-fault-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-storage-fault-smoke.ts",
    "runtime-sidecar:provider-worker-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-provider-worker-smoke.ts",
    "runtime-sidecar:rust-agent-loop-smoke": "npm run runtime-sidecar:build && node --import tsx/esm scripts/runtime-sidecar-rust-agent-loop-smoke.ts",
    "runtime-sidecar:external-provider-smoke": "node -e \"const missing=['SYNAX_EXTERNAL_PROVIDER_BASE_URL','SYNAX_EXTERNAL_PROVIDER_API_KEY','SYNAX_EXTERNAL_PROVIDER_MODEL'].filter((name)=>!process.env[name]?.trim()); if(missing.length){console.error('External provider smoke skipped: missing '+missing.join(', ')); process.exit(2)}\" && npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-external-provider-smoke.ts",
    "runtime-sidecar:physical-enospc-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-sidecar-physical-enospc-smoke.ts",
    "runtime-sidecar:cutover-smoke": "tsx scripts/runtime-sidecar-cutover-smoke.ts",
    "runtime:e2e": "npm run runtime-sidecar:build && tsx scripts/runtime-v2-main-path-e2e.ts",
    "runtime:repository-smoke": "npm run runtime-sidecar:build && tsx scripts/runtime-repository-smoke.ts",
    "test:conversation-git": "tsx scripts/conversation-git-smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^0.1.100",
    "@trycua/cua-driver": "0.30.2",
    "@typesafe-ai/sdk": "0.6.0",
    "@vscode/ripgrep-universal": "^1.18.0",
    "dotenv": "^16.4.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.2",
    "hono": "^4.7.0",
    "ignore": "^7.0.13",
    "js-tiktoken": "^1.0.21",
    "jsonc-parser": "^3.3.1",
    "mdast-util-from-markdown": "2.0.3",
    "nanoid": "^5.0.0",
    "node-pty": "1.1.0",
    "parse5": "^7.3.0",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.6.0",
    "playwright-core": "^1.61.1",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "smol-toml": "^1.8.0",
    "trash": "^10.1.1",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "2.10.3",
    "app-builder-bin": "4.2.0",
    "electron": "44.8.0",
    "electron-builder": "26.8.1",
    "electron-updater": "6.8.9",
    "electronmon": "^2.0.4",
    "esbuild": "0.27.7",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.6",
    "yauzl": "3.4.0"
  }
}
