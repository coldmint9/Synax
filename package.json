{
  "name": "synax",
  "private": true,
  "version": "0.1.0-snapshot",
  "license": "MIT",
  "author": "Synax",
  "description": "AI-powered code analysis platform",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "postinstall": "tsx scripts/ensure-sqlite-shim.ts",
    "dev:api": "tsx scripts/dev-api.ts",
    "dev:web": "tsx scripts/dev-web.ts",
    "dev:all": "tsx scripts/dev-all.ts",
    "build": "tsup --config tsup.config.ts",
    "postbuild": "tsx scripts/copy-native-modules.ts",
    "start": "node ./server-dist/server.cjs",
    "start:api": "tsx scripts/start-api.ts",
    "web:dev": "npm run dev:web",
    "analyzer:dev": "npm run dev:api",
    "analyzer:start": "npm run start:api",
    "web:build": "npm run --prefix web build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint api/",
    "test": "vitest run",
    "dev:desktop": "tsx scripts/dev-desktop.ts",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:desktop": "npm run build && npm run web:build && npm run build:electron && electron-forge package",
    "make:desktop": "npm run build && npm run web:build && npm run build:electron && electron-forge make",
    "start:desktop": "electron-forge start"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.20.0",
    "@ai-sdk/anthropic": "^3.0.77",
    "@ai-sdk/cerebras": "^2.0.51",
    "@ai-sdk/cohere": "^3.0.35",
    "@ai-sdk/deepinfra": "^2.0.51",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.73",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/mistral": "^3.0.36",
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@ai-sdk/perplexity": "^3.0.33",
    "@ai-sdk/togetherai": "^2.0.51",
    "@ai-sdk/xai": "^3.0.89",
    "@hono/node-server": "^1.13.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "libsql": "^0.5.28",
    "ai": "^6.0.180",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^1.0.0-beta.19-d95b7a4",
    "hono": "^4.7.0",
    "js-tiktoken": "^1.0.21",
    "mermaid": "^11.15.0",
    "motion": "^12.38.0",
    "nanoid": "^5.0.0",
    "pino": "^9.6.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@types/node": "^22.10.0",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electronmon": "^2.0.4",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  }
}
