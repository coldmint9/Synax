{
  "name": "synax",
  "private": false,
  "version": "0.1.2",
  "license": "MIT",
  "author": "Synax",
  "description": "AI-powered code analysis platform",
  "type": "module",
  "main": "dist-electron/main.js",
  "files": [
    "server-dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/integration"
  ],
  "bin": {
    "synax": "server-dist/cli.cjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:api": "tsx scripts/dev-api.ts",
    "dev:web": "tsx scripts/dev-web.ts",
    "dev:all": "tsx scripts/dev-all.ts",
    "prebuild": "tsx scripts/generate-wiki-skill-bundle.ts",
    "build": "tsup --config tsup.config.ts",
    "postbuild": "tsx scripts/copy-native-modules.ts",
    "prepack": "npm run build",
    "start": "node ./server-dist/server.cjs",
    "cli": "tsx cli/index.ts",
    "cli:build": "npm run build",
    "start:api": "tsx scripts/start-api.ts",
    "web:dev": "npm run dev:web",
    "analyzer:dev": "npm run dev:api",
    "analyzer:start": "npm run start:api",
    "web:build": "npm run --prefix web build",
    "typecheck": "tsc --noEmit",
    "typecheck:cli": "tsc -p cli/tsconfig.json --noEmit",
    "lint": "eslint api/",
    "test": "vitest run",
    "bench:repl": "tsx scripts/tree-embedding-repl.ts",
    "bench:eval": "tsx scripts/tree-embedding-repl.ts --eval",
    "dev:desktop": "tsx scripts/dev-desktop.ts",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:desktop": "npm run build && npm run web:build && npm run build:electron && electron-forge package",
    "make:desktop": "npm run build && npm run web:build && npm run build:electron && electron-forge make",
    "start:desktop": "electron-forge start"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/cerebras": "^3.0.48",
    "@ai-sdk/cohere": "^4.0.41",
    "@ai-sdk/deepinfra": "^3.0.48",
    "@ai-sdk/deepseek": "^3.0.44",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/groq": "^4.0.41",
    "@ai-sdk/mistral": "^4.0.43",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@ai-sdk/perplexity": "^4.0.43",
    "@ai-sdk/provider": "^4.0.14",
    "@ai-sdk/provider-utils": "^5.0.40",
    "@ai-sdk/togetherai": "^3.0.49",
    "@ai-sdk/xai": "^4.0.58",
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "@hono/node-server": "^1.13.0",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.99",
    "beautiful-mermaid": "^1.1.3",
    "diff": "^9.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^1.0.0-beta.19-d95b7a4",
    "hono": "^4.7.0",
    "js-tiktoken": "^1.0.21",
    "libsql": "^0.5.28",
    "mermaid": "^11.15.0",
    "motion": "^12.38.0",
    "nanoid": "^5.0.0",
    "parse5": "^7.3.0",
    "pino": "^9.6.0",
    "playwright-core": "^1.61.1",
    "shiki": "^4.4.3",
    "tree-sitter": "^0.25.0",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@types/node": "^22.10.0",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electronmon": "^2.0.4",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  }
}
