{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./services/local-node/*"]
    }
  },
  "include": ["services/**/*.ts", "packages/**/*.ts"],
  "exclude": ["node_modules", "dist", "client", "analyzer"]
}
