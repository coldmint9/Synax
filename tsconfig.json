{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "api",
    "declaration": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./api/*"]
    }
  },
  "include": ["api/**/*.ts"],
  "exclude": ["node_modules", "dist", "web", "analyzer"]
}
